# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for privileged chat/profile persistence. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Optional full OpenAI-compatible URL. Only router.huggingface.co or
# *.endpoints.huggingface.cloud is allowed; must end in /v1/chat/completions.
# Set this only after an HF Inference Endpoint actually serves the intended model/adapter.
HF_CHAT_COMPLETIONS_URL=
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Required for Production distributed chat rate-limit; both values must be set
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a unique 32+ character secret in the deployment environment
RATE_LIMIT_KEY_SALT=

# Required for the Production deployment health gate (minimum 32 characters)
HEALTHCHECK_TOKEN=
