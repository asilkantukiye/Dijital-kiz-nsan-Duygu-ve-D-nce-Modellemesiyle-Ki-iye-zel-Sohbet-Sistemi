# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for privileged chat/profile persistence.
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face
HF_TOKEN=
# Use the adapter alias configured in the vLLM endpoint, not the private adapter repo ID.
# Example after the endpoint is ready: HF_MODEL=dijital-ikiz
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Optional OpenAI-compatible Hugging Face Inference Endpoint URL.
# Must use HTTPS and end in /v1/chat/completions.
HF_CHAT_COMPLETIONS_URL=
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Required for Production distributed chat rate-limit; both values must be set
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_SALT=

# Required for the Production deployment health gate (minimum 32 characters)
HEALTHCHECK_TOKEN=
